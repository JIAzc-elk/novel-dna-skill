    },
    {
      "id": "find-shortage",
      "claim": "陈立发现账目短少",
      "match_any": ["发现账册少了", "查出账面短了"]
    },
    {
      "id": "sign-contract",
      "claim": "双方签下雇工契约",
      "match_any": ["签好雇工契约", "按下雇工契约的手印"]
    }
  ],
  "order": [
    {"before": "inspect-ledger", "after": "find-shortage"},
    {"before": "find-shortage", "after": "sign-contract"}
  ]
