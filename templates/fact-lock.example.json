    },
    {
      "id": "ledger-shortage",
      "claim": "旧账短少三两银子",
      "match_any": ["账册少了三两银子", "账面短了三两"],
      "conflict_any": ["账册少了五两银子", "账面短了二两"]
    }
  ],
  "events": [
    {
      "id": "inspect-ledger",
      "claim": "陈立检查旧账",
